.PHONY: clean distclean

PREFIX ?= @prefix@
CXX = @CXX@
CXXFLAGS = @CXXFLAGS@

CC = @CC@
CFLAGS = @CFLAGS@

CCTOOLS ?= @CCTOOLS@
CCTOOLS_INCLUDES ?= -I$(CCTOOLS)/include
# CCTOOLS_INCLUDES = -I$(PREFIX)/include/ppc-cctools

LLDB ?= @LLDB@
UNWIND ?= @UNWIND@
UNWIND_INCLUDES ?= -I$(UNWIND)/include -I$(UNWIND)/src
# UNWIND_INCLUDES = -I$(PREFIX)/include/ppc-libunwind

INCLUDES_TARGET = \
	$(CCTOOLS_INCLUDES) $(UNWIND_INCLUDES) \
	-Isrc/ld -Isrc/abstraction

INCLUDES_HOST = \
	$(UNWIND_INCLUDES) \
	-Isrc/ld -Isrc/abstraction \
	$(patsubst -I%,-idirafter %,$(CCTOOLS_INCLUDES))

DEFINE_NS_GET_EXECUTABLE_PATH_BUF_UINT32 ?= @DEFINE_NS_GET_EXECUTABLE_PATH_BUF_UINT32@
DEFINES = \
	$(DEFINE_NS_GET_EXECUTABLE_PATH_BUF_UINT32) \
	-DSUPPORT_ARCH_i386 -DSUPPORT_ARCH_x86_64 \
	-DSUPPORT_ARCH_ppc -DSUPPORT_ARCH_ppc64

OPTFLAGS = -O0
DEBUGFLAGS = -g0

LDFLAGS ?=
LIBS ?=

SRCS_C = $(wildcard src/ld/*.c)
OBJS_C = $(SRCS_C:.c=.o)

SRCS_CPP_HOST = src/ld/Options.cpp
SRCS_CPP_TARGET = $(filter-out $(SRCS_CPP_HOST), $(wildcard src/ld/*.cpp))
OBJS_CPP_HOST = $(SRCS_CPP_HOST:.cpp=.o)
OBJS_CPP_TARGET = $(SRCS_CPP_TARGET:.cpp=.o)

OBJS = $(OBJS_C) $(OBJS_CPP_HOST) $(OBJS_CPP_TARGET)

all: ld64 libprunetrie.a

$(OBJS_C): %.o: %.c
	$(CC) $(OPTFLAGS) $(DEBUGFLAGS) $(DEFINES) $(INCLUDES_TARGET) \
		$(CFLAGS) -c $< -o $@

$(OBJS_CPP_HOST): %.o: %.cpp
	$(CXX) $(OPTFLAGS) $(DEBUGFLAGS) $(DEFINES) $(INCLUDES_HOST) \
		$(CXXFLAGS) -c $< -o $@

$(OBJS_CPP_TARGET): %.o: %.cpp
	$(CXX) $(OPTFLAGS) $(DEBUGFLAGS) $(DEFINES) $(INCLUDES_TARGET) \
		$(CXXFLAGS) -c $< -o $@

ld64: $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LDFLAGS) $(LIBS)

clean:
	rm -f $(OBJS) ld
	rm -f PruneTrie.o libprunetrie.a

distclean: clean
	rm -rf autom4te.cache configure~
	rm -f GNUmakefile config.status config.log

install: ld64
	mkdir -p $(DESTDIR)$(PREFIX)/bin
	install -m 755 ld64 $(DESTDIR)$(PREFIX)/bin/ld64

libprunetrie.a: PruneTrie.o
	$(AR) $(ARFLAGS) $@ $^

PruneTrie.o: src/other/PruneTrie.cpp
	$(CXX) $(OPTFLAGS) $(DEBUGFLAGS) $(DEFINES) $(INCLUDES_TARGET) \
		$(CXXFLAGS) -Isrc/other -o $@ -c $<

install-prune-trie: libprunetrie.a
	mkdir -p $(DESTDIR)$(PREFIX)/include/ppc-ld64/mach-o
	install -m 744 src/other/prune_trie.h $(DESTDIR)$(PREFIX)/include/ppc-ld64/mach-o
	mkdir -p $(DESTDIR)$(PREFIX)/libexec/ppc-ld64/
	install -m 744 libprunetrie.a $(DESTDIR)$(PREFIX)/libexec/ppc-ld64/
